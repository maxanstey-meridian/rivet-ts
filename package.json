{
  "name": "@maxanstey-meridian/rivet-ts",
  "version": "0.16.1",
  "description": "TypeScript contract extractor for Rivet",
  "keywords": [
    "codegen",
    "contracts",
    "openapi",
    "rivet",
    "typescript"
  ],
  "homepage": "https://maxanstey-meridian.github.io/rivet-ts/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxanstey-meridian/rivet-ts.git"
  },
  "bin": {
    "rivet-reflect-ts": "./dist/interfaces/cli/main.js",
    "rivet-ts": "./dist/interfaces/cli/main.js"
  },
  "files": [
    "dist",
    "templates/example",
    "templates/shared",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "lint": "oxlint src/ tests/ templates/",
    "lint:fix": "oxlint --fix src/ tests/ templates/",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "analyze": "npx gitnexus analyze",
    "test": "pnpm build && vitest run",
    "test:watch": "pnpm build && (tsc -p tsconfig.build.json --watch --preserveWatchOutput > /dev/null & vitest; kill $!)",
    "check": "tsc --noEmit && tsc --noEmit -p templates"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "tar": "^7.4.3",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.4",
    "@types/node": "^25.5.2",
    "ajv": "^8.20.0",
    "dexie": "^4.4.3",
    "eslint": "^10.11.0",
    "hono": "^4.12.14",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "typed-inject": "^5.0.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.3.11",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.24.0"
}

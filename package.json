{
  "name": "rivet-ts",
  "version": "0.10.0",
  "private": true,
  "description": "TypeScript contract extractor for Rivet",
  "keywords": [
    "codegen",
    "contracts",
    "openapi",
    "rivet",
    "typescript"
  ],
  "license": "MIT",
  "bin": {
    "rivet-reflect-ts": "./dist/interfaces/cli/main.js",
    "rivet-ts": "./dist/interfaces/cli/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "lint": "oxlint src/ tests/",
    "lint:fix": "oxlint --fix src/ tests/",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "analyze": "gitnexus analyze",
    "test": "pnpm build && vitest run",
    "test:watch": "pnpm build && vitest",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "tar": "^7.4.3",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^17.3.10",
    "gitnexus": "1.6.5",
    "hono": "^4.12.14",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "vite": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ladybugdb/core",
      "gitnexus",
      "onnxruntime-node",
      "protobufjs",
      "sharp",
      "tree-sitter",
      "tree-sitter-c",
      "tree-sitter-c-sharp",
      "tree-sitter-cpp",
      "tree-sitter-go",
      "tree-sitter-java",
      "tree-sitter-javascript",
      "tree-sitter-kotlin",
      "tree-sitter-php",
      "tree-sitter-python",
      "tree-sitter-ruby",
      "tree-sitter-rust",
      "tree-sitter-typescript"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}

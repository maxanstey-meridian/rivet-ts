{
  // Type-checks the scaffold templates as one api package. The scaffold
  // resolves "@maxanstey-meridian/rivet-ts" from npm, "#contract" through the emitted package.json
  // `imports`, and the generated contract JSON at scaffold time; here they map
  // onto this repo's sources and a checked-in stub.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "rootDirs": ["example/apps/api", "shared/apps/api", "typecheck/apps/api"],
    "paths": {
      "@maxanstey-meridian/rivet-ts": ["../src/index.ts"],
      "@maxanstey-meridian/rivet-ts/hono": ["../src/hono.ts"],
      "#contract": ["./example/apps/api/src/contracts.ts"]
    }
  },
  "include": ["example/apps/api", "shared/apps/api"]
}
